# ── MindBridge — Production Environment (rendered by Ansible) ─────────────────
# Deployed to: /opt/mindbridge/.env on VPS
# NEVER commit this file — it contains real secrets

DATABASE_URL=postgresql://mindbridge_user:{{ db_password }}@db:5432/mindbridge_db
SECRET_KEY={{ secret_key }}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# Privacy — HMAC key for anon_token generation
HMAC_SECRET={{ hmac_secret }}

# Database
DB_PASSWORD={{ db_password }}

# AI (Anthropic)
AI_API_KEY={{ ai_api_key }}
AI_MODEL=claude-sonnet-4-20250514

# App
APP_NAME=MindBridge
ENVIRONMENT=production
DEBUG=false

# CORS — allow the VPS IP and any frontend origin
CORS_ORIGINS=http://{{ ansible_host }},http://{{ ansible_host }}:8000,http://localhost:5173

# Google OAuth (optional — leave blank if not configured)
GOOGLE_CLIENT_ID={{ google_client_id | default('') }}

# Email (optional — leave blank to disable email features)
SMTP_HOST={{ smtp_host | default('') }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ smtp_password | default('') }}
