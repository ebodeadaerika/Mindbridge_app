# ── MindBridge — Environment Template (Ansible Jinja2) ────────────────────────
# Rendered by Ansible deploy_app.yml → /opt/mindbridge/.env on VPS
# Variables are pulled from Ansible Vault or --extra-vars

DATABASE_URL=postgresql://{{ db_user }}:{{ db_password }}@localhost:5432/{{ db_name }}
SECRET_KEY={{ secret_key }}
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# AI
AI_API_KEY={{ ai_api_key }}
AI_MODEL=claude-sonnet-4-20250514

# App
APP_NAME=MindBridge
ENVIRONMENT=production
CORS_ORIGINS=https://{{ domain_name }},http://localhost:5173

# Google OAuth
GOOGLE_CLIENT_ID={{ google_client_id }}

# Email
SMTP_HOST={{ smtp_host | default('smtp.gmail.com') }}
SMTP_PORT={{ smtp_port | default(587) }}
SMTP_USER={{ smtp_user | default('') }}
SMTP_PASSWORD={{ smtp_password | default('') }}
