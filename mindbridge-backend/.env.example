# MindBridge — Environment Variables
# Copy this to .env and fill in your values. NEVER commit .env to git.

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mindbridge_user:mindbridge_pass@db:5432/mindbridge_db

# ── JWT Auth ─────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Companion ─────────────────────────────────────────────────────────────
AI_API_KEY=your-groq-api-key-here
AI_MODEL=llama-3.3-70b-versatile

# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
APP_NAME=MindBridge
APP_VERSION=1.0.0

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database Pool ─────────────────────────────────────────────────────────────
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
